{
  "name": "mindtero",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "npm run build && node scripts/run-electron.cjs",
    "electron:build": "npm run build && node scripts/run-electron.cjs"
  },
  "description": "Visual thinking layer for a local Zotero library: spatial boards, typed relations, PDF quote cards and page snapshots.",
  "main": "electron/main.cjs",
  "author": "we4OnTop",
  "build": {
    "appId": "app.mindtero.desktop",
    "productName": "Mindtero",
    "win": {
      "icon": "electron/icon.ico"
    },
    "files": [
      "electron/**",
      "dist/**"
    ]
  },
  "dependencies": {

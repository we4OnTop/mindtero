    "@tanstack/react-query": "^5.102.8",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.42.0",
    "nanoid": "^6.0.1",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.4",
